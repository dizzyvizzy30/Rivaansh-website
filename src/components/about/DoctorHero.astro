---
// About Us opener: portrait with experience badge + name, title, bio, credential chips, CTA.
import MediaImage from '../media/MediaImage.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import type { ImageItem } from '../media/types';

interface Props {
  doctor: {
    label: string;
    name: string;
    title: string;
    bio: string;
    credentials: ReadonlyArray<string>;
    portrait: ImageItem;
    badge: { value: string; label: string };
    cta: { label: string; href: string };
  };
}

const { doctor } = Astro.props;
---

<section class="doctor-hero">
  <div class="doctor-hero-bg" aria-hidden="true"></div>
  <div class="doctor-hero-content">
    <div class="doctor-hero-image" data-animate="fade-right">
      <MediaImage
        image={doctor.portrait}
        sizes="(max-width: 480px) 280px, (max-width: 1024px) 350px, 400px"
        priority
      />
      <div class="doctor-hero-badge">
        <span>{doctor.badge.value}</span>
        <small>{doctor.badge.label}</small>
      </div>
    </div>
    <div class="doctor-hero-info" data-animate="fade-left">
      <p class="doctor-hero-label">{doctor.label}</p>
      <h1>{doctor.name}</h1>
      <p class="doctor-hero-title">{doctor.title}</p>
      <p class="doctor-hero-bio">{doctor.bio}</p>
      <ul class="doctor-credentials-grid" aria-label="Qualifications">
        {doctor.credentials.map((credential) => (
          <li class="credential-item">
            <Icon name="check-circle" />
            <span>{credential}</span>
          </li>
        ))}
      </ul>
      <Button href={doctor.cta.href} variant="primary" size="large" arrow>{doctor.cta.label}</Button>
    </div>
  </div>
</section>

<style>
  .doctor-hero {
    position: relative;
    min-height: 80vh;
    display: flex;
    align-items: center;
    padding: 6rem 2rem 4rem;
    overflow: hidden;
  }

  .doctor-hero-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--color-bg-alt) 0%, var(--color-primary-light) 50%, var(--color-bg-alt) 100%);
    z-index: 0;
  }

  .doctor-hero-bg::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 80%;
    height: 150%;
    background: radial-gradient(circle, rgba(143, 188, 143, 0.15) 0%, transparent 70%);
    z-index: 1;
  }

  .doctor-hero-content {
    position: relative;
    z-index: 2;
    max-width: var(--width-wide);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 400px 1fr;
    gap: 4rem;
    align-items: center;
  }

  .doctor-hero-image {
    position: relative;
  }

  .doctor-hero-image :global(img) {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: var(--radius-xl);
    box-shadow: 0 25px 50px rgba(0, 0, 0, 0.15);
  }

  .doctor-hero-badge {
    position: absolute;
    bottom: -20px;
    right: -20px;
    background: linear-gradient(135deg, var(--color-primary-ink), var(--color-primary-ink-hover));
    color: var(--color-text-on-dark);
    padding: 1.25rem;
    border-radius: var(--radius-lg);
    text-align: center;
    box-shadow: 0 10px 30px rgba(143, 188, 143, 0.4);
  }

  .doctor-hero-badge span {
    display: block;
    font-size: 2rem;
    font-weight: 700;
    line-height: 1;
  }

  .doctor-hero-badge small {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .doctor-hero-info {
    padding: 2rem 0;
  }

  .doctor-hero-label {
    display: inline-block;
    background: rgba(143, 188, 143, 0.15);
    color: var(--color-primary-ink);
    padding: 0.5rem 1rem;
    border-radius: 50px;
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }

  .doctor-hero-info h1 {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    color: var(--color-text);
    margin-bottom: 0.5rem;
    letter-spacing: -0.02em;
  }

  .doctor-hero-title {
    font-size: 1.25rem;
    color: var(--color-primary-ink);
    font-weight: 600;
    margin-bottom: 1.5rem;
  }

  .doctor-hero-bio {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    line-height: 1.8;
    margin-bottom: 2rem;
  }

  .doctor-credentials-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .credential-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem;
    background: var(--color-bg);
    border-radius: 10px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  }

  .credential-item :global(svg) {
    width: 24px;
    height: 24px;
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .credential-item span {
    font-size: 0.9rem;
    color: var(--color-text);
    font-weight: 500;
    text-align: left;
  }

  @media (max-width: 1024px) {
    .doctor-hero-content {
      grid-template-columns: 1fr;
      gap: 3rem;
      text-align: center;
    }

    .doctor-hero-image {
      max-width: 350px;
      margin: 0 auto;
    }

    .doctor-hero-badge {
      right: 0;
    }

    .doctor-credentials-grid {
      max-width: 400px;
      margin: 0 auto 2rem;
    }

    .doctor-hero-info :global(.btn) {
      margin: 0 auto;
    }
  }

  @media (max-width: 768px) {
    .doctor-hero {
      padding: 5rem 1rem 3rem;
      min-height: auto;
    }

    .doctor-hero-info h1 {
      font-size: 2rem;
    }

    .doctor-credentials-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .doctor-hero-image {
      max-width: 280px;
    }

    .doctor-hero-badge {
      padding: 1rem;
      bottom: -15px;
      right: -10px;
    }

    .doctor-hero-badge span {
      font-size: 1.5rem;
    }
  }
</style>
