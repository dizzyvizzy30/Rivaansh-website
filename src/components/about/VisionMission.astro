---
import Icon, { type IconName } from '../ui/Icon.astro';

interface Props {
  cards: ReadonlyArray<{ icon: IconName; title: string; text: string }>;
}

const { cards } = Astro.props;
---

<section class="vm-section" aria-label="Vision and mission">
  <div class="vm-container">
    {cards.map((card, index) => (
      <div class="vm-card" data-animate="fade-up" data-animate-delay={String(index + 1)}>
        <div class="vm-icon-wrapper">
          <Icon name={card.icon} />
        </div>
        <h2>{card.title}</h2>
        <p>{card.text}</p>
        <div class="vm-accent" aria-hidden="true"></div>
      </div>
    ))}
  </div>
</section>

<style>
  .vm-section {
    padding: 5rem 2rem;
    background: linear-gradient(180deg, var(--color-bg-alt) 0%, var(--color-bg) 100%);
  }

  .vm-container {
    max-width: 1000px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .vm-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 2.5rem;
    text-align: center;
    position: relative;
    overflow: hidden;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.06);
    transition: transform var(--duration-base) ease, box-shadow var(--duration-base) ease;
  }

  .vm-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--color-primary), var(--color-primary-dark));
  }

  .vm-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.1);
  }

  .vm-icon-wrapper {
    width: 70px;
    height: 70px;
    background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary-tint));
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  .vm-icon-wrapper :global(svg) {
    width: 32px;
    height: 32px;
    color: var(--color-primary-dark);
  }

  .vm-card h2 {
    font-size: 1.5rem;
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  .vm-card p {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.8;
  }

  .vm-accent {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--color-primary), var(--color-primary-dark));
  }

  @media (max-width: 1024px) {
    .vm-container {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .vm-section {
      padding: 3rem 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vm-card {
      transition: none;
    }

    .vm-card:hover {
      transform: none;
    }
  }
</style>
