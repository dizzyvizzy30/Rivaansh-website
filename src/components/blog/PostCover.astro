---
// Blog cover photo, or a branded placeholder tile when a post has no cover yet.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import MediaImage from '../media/MediaImage.astro';
import logo from '../../assets/images/brand/logo.jpeg';

interface Props {
  cover?: ImageMetadata;
  alt?: string;
  sizes: string;
  priority?: boolean;
  class?: string;
}

const { cover, alt = '', sizes, priority = false, class: className } = Astro.props;
---

{cover ? (
  <MediaImage image={{ src: cover, alt }} sizes={sizes} priority={priority} class={className} />
) : (
  <div class:list={['post-cover-placeholder', className]} aria-hidden="true">
    <Image src={logo} alt="" width={72} height={72} densities={[1, 2]} />
  </div>
)}

<style>
  .post-cover-placeholder {
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 30% 20%, rgba(255, 255, 255, 0.7) 0%, transparent 60%),
      linear-gradient(135deg, var(--color-primary-light) 0%, var(--color-primary-tint) 100%);
  }

  .post-cover-placeholder :global(img) {
    width: 72px;
    height: 72px;
    border-radius: var(--radius-lg);
    mix-blend-mode: multiply;
    opacity: 0.85;
  }
</style>
