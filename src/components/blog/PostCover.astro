---
// Blog / Health Tips cover photo. Without a cover, nothing is rendered (no logo filler tiles).
import type { ImageMetadata } from 'astro';
import MediaImage from '../media/MediaImage.astro';

interface Props {
  cover?: ImageMetadata;
  alt?: string;
  sizes: string;
  priority?: boolean;
  class?: string;
}

const { cover, alt = '', sizes, priority = false, class: className } = Astro.props;
---

{cover && <MediaImage image={{ src: cover, alt }} sizes={sizes} priority={priority} class={className} />}
