---
// One doctor data source shown at three levels of detail (round-2 redundancy rule 3):
// `facts` (Home, no photo - the hero carries the face) → `mini` (condition pages) → `feature` (Doctor & Clinic).
import PhotoSlot from '../media/PhotoSlot.astro';
import InfoNeeded from '../ui/InfoNeeded.astro';
import { doctor } from '../../data/doctor-clinic';
import { slotImage } from '../../data/photo-slots';
import { site } from '../../config/site';
import { routes } from '../../config/navigation';

interface Props {
  variant?: 'feature' | 'mini' | 'facts';
  headingLevel?: 2 | 3;
  showLink?: boolean;
  linkText?: string;
}

const { variant = 'feature', headingLevel = 3, showLink = true, linkText = 'About the doctor and the centre' } = Astro.props;
const { registration, council } = site.doctor;
const portrait = slotImage(doctor.portraitSlot);
const qualificationLabel = (q: (typeof doctor.qualifications)[number]) =>
  [q.degree, [q.institute, q.year].filter(Boolean).join(', ')].filter(Boolean).join(' - ');
---

<div class:list={['doctor-card', `doctor-card--${variant}`, variant !== 'facts' && !portrait && 'doctor-card--no-photo']}>
  {variant !== 'facts' && portrait && (
    <PhotoSlot id={doctor.portraitSlot} sizes={variant === 'mini' ? '96px' : '(max-width: 768px) 70vw, 320px'} class="doctor-photo" aspect={variant === 'mini' ? '1 / 1' : undefined} />
  )}
  <div class="doctor-body">
    {headingLevel === 2 ? <h2 class="doctor-name">{doctor.name}</h2> : <h3 class="doctor-name">{doctor.name}</h3>}
    <p class="doctor-role">{doctor.role}</p>
    <ul class="doctor-qualifications">
      {(variant === 'feature' ? doctor.qualifications.map(qualificationLabel) : doctor.qualifications.map((q) => q.degree)).map((q) => <li>{q}</li>)}
      {registration && <li>Reg. no. {registration}{council && variant === 'feature' ? `, ${council}` : ''}</li>}
    </ul>
    {variant === 'feature' && (
      <>
        {!registration && <InfoNeeded what="registration number and council" folder="02-doctor-profile" />}
        {doctor.qualifications.some((q) => !q.institute) && <InfoNeeded what="institute and year for each qualification" folder="02-doctor-profile" />}
        {doctor.bio.map((paragraph) => <p class="doctor-bio">{paragraph}</p>)}
        {doctor.interests ? <p class="doctor-bio"><strong>Areas of interest:</strong> {doctor.interests}</p> : <InfoNeeded what="areas of special interest" folder="02-doctor-profile" />}
        {doctor.languages ? <p class="doctor-bio"><strong>Languages:</strong> {doctor.languages}</p> : <InfoNeeded what="languages spoken" folder="02-doctor-profile" />}
      </>
    )}
    {variant === 'facts' && (
      <>
        {doctor.languages && <p class="doctor-bio">Languages: {doctor.languages}</p>}
        <p class="doctor-bio">{doctor.bio[0]}</p>
      </>
    )}
    {showLink && <a class="doctor-link" href={`${routes.doctorClinic}#doctor`}>{linkText}</a>}
  </div>
</div>

<style>
  .doctor-card {
    display: grid;
    align-items: center;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
  }

  .doctor-card--feature {
    grid-template-columns: minmax(0, 320px) 1fr;
    gap: 2.5rem;
    padding: 2rem;
  }

  .doctor-card--mini {
    grid-template-columns: 96px 1fr;
    gap: 1.25rem;
    padding: 1.25rem;
  }

  .doctor-card--facts {
    grid-template-columns: 1fr;
    padding: 1.5rem;
    align-items: start;
  }

  .doctor-card--no-photo {
    grid-template-columns: 1fr;
  }

  .doctor-card--mini :global(.doctor-photo) {
    border-radius: var(--radius-full);
  }

  .doctor-card--mini :global(.photo-slot--empty) {
    padding: 0.25rem;
    font-size: 0.5rem;
  }

  .doctor-name {
    font-size: 1.5rem;
    letter-spacing: -0.01em;
  }

  .doctor-card--mini .doctor-name {
    font-size: 1.125rem;
  }

  .doctor-role {
    color: var(--color-primary-ink);
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .doctor-card--mini .doctor-role {
    margin-bottom: 0.25rem;
    font-size: 0.9375rem;
  }

  .doctor-qualifications {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .doctor-qualifications li {
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-full);
    background: var(--color-primary-light);
    color: var(--color-primary-ink);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .doctor-bio {
    color: var(--color-text-muted);
    line-height: 1.7;
    margin: 0.5rem 0;
  }

  .doctor-bio strong {
    color: var(--color-text);
  }

  .doctor-link {
    display: inline-block;
    margin-top: 0.5rem;
    font-weight: 600;
    color: var(--color-primary-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 768px) {
    .doctor-card--feature {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 1.25rem;
    }

    .doctor-card--feature :global(.doctor-photo) {
      max-width: 280px;
    }
  }
</style>
