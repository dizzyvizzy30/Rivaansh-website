---
// Homepage hero: one still photo under a calm, static overlay — who, what, where, and how to reach the clinic now.
import MediaImage from '../media/MediaImage.astro';
import ContactActions from '../ui/ContactActions.astro';
import Icon from '../ui/Icon.astro';
import TodayHours from '../layout/TodayHours.astro';
import { site } from '../../config/site';
import { hero } from '../../data/home';
---

<section class="hero">
  <MediaImage image={hero.image} sizes="100vw" priority class="hero-photo" />
  <div class="hero-content">
    <p class="hero-kicker">{hero.kicker} <span lang="gu">· {site.localTagline}</span></p>
    <h1 class="hero-title">{hero.title}</h1>
    <p class="hero-doctor">{hero.doctorLine}</p>
    <ul class="hero-facts">
      <li><Icon name="clock" /><TodayHours /></li>
      <li><Icon name="map-pin" />{site.contact.address.short}</li>
    </ul>
    <ContactActions tone="on-dark" showBook />
  </div>
  <div class="hero-wave" aria-hidden="true">
    <svg viewBox="0 0 1440 120" preserveAspectRatio="none">
      <path d="M0,64 C288,120 720,0 1440,64 L1440,120 L0,120 Z"></path>
    </svg>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(640px, 78vh);
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: 4rem var(--gutter) 6rem;
    isolation: isolate;
  }

  .hero {
    background: var(--color-surface-dark);
  }

  /* Wide screens: photo fills the right half, text sits on solid slate on the left. */
  .hero :global(.hero-photo) {
    position: absolute;
    top: 0;
    right: 0;
    width: 52%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }

  /* Static overlay blends the photo into the slate panel and keeps text readable. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, var(--color-surface-dark) 0%, var(--color-surface-dark) 46%, rgba(30, 41, 59, 0.55) 62%, rgba(30, 41, 59, 0.1) 100%);
  }

  .hero-content {
    width: 100%;
    max-width: var(--width-wide);
    margin: 0 auto;
    color: var(--color-text-on-dark);
  }

  .hero-content > * {
    max-width: 44rem;
  }

  .hero-kicker {
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #d6ead6;
    margin-bottom: 0.75rem;
  }

  .hero-title {
    color: var(--color-text-on-dark);
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
  }

  .hero-doctor {
    font-size: 1.125rem;
    color: #e2e8f0;
    margin-bottom: 1.25rem;
  }

  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-bottom: 1.75rem;
    color: #e2e8f0;
  }

  .hero-facts li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .hero-facts :global(svg) {
    width: 18px;
    height: 18px;
    color: #b7dbb7;
  }

  .hero-wave {
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 100%;
    line-height: 0;
  }

  .hero-wave svg {
    display: block;
    width: 100%;
    height: 64px;
  }

  .hero-wave path {
    fill: var(--color-bg);
  }

  @media (max-width: 900px) {
    .hero :global(.hero-photo) {
      width: 100%;
    }

    .hero::before {
      background: linear-gradient(180deg, rgba(15, 23, 42, 0.84) 0%, rgba(30, 41, 59, 0.8) 100%);
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 0;
      padding: 2.5rem var(--gutter-mobile) 4.5rem;
    }

    /* Phones: the bottom action bar already offers Directions and Book — keep only Call here. */
    .hero :global(.contact-actions .btn--light) {
      display: none;
    }

    .hero-doctor {
      font-size: 1rem;
    }

    .hero-wave svg {
      height: 40px;
    }
  }
</style>
