---
// Ear / Nose / Throat service cards with a green accent bar and a subtle 3D tilt on hover (pointer devices only).
import Icon, { type IconName } from '../ui/Icon.astro';

interface Props {
  columns: ReadonlyArray<{ icon: IconName; title: string; items: ReadonlyArray<string> }>;
}

const { columns } = Astro.props;
---

<section class="main-services" aria-label="Our services">
  {columns.map((column, index) => (
    <div class="service-box" data-animate="fade-up" data-animate-delay={String(index + 1)} data-tilt>
      <div class="service-icon">
        <Icon name={column.icon} />
      </div>
      <h2>{column.title}</h2>
      <ul>
        {column.items.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  ))}
</section>

<style>
  .main-services {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    padding: 4rem 2rem;
    max-width: var(--width-wide);
    margin: 0 auto;
  }

  .service-box {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2rem;
    transition: transform var(--duration-base) ease, box-shadow var(--duration-base) ease, border-color var(--duration-base) ease;
    position: relative;
    overflow: hidden;
    transform-style: preserve-3d;
    perspective: 1000px;
  }

  .service-box::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: linear-gradient(180deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    border-radius: var(--radius-lg) 0 0 var(--radius-lg);
    transition: width var(--duration-base) ease;
  }

  .service-box:hover::before {
    width: 6px;
  }

  .service-box::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 0%, var(--color-primary-light) 0%, transparent 70%);
    opacity: 0;
    transition: opacity var(--duration-base) ease;
    pointer-events: none;
    z-index: 0;
  }

  .service-box:hover::after {
    opacity: 0.5;
  }

  .service-box:hover {
    box-shadow: var(--shadow-brand);
    border-color: var(--color-primary-light);
  }

  .service-icon {
    width: 64px;
    height: 64px;
    margin-bottom: 1.25rem;
    color: var(--color-primary);
    transition: transform var(--duration-base) ease, color var(--duration-base) ease;
    position: relative;
    z-index: 1;
  }

  .service-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .service-box:hover .service-icon {
    color: var(--color-primary-dark);
    animation: icon-bounce 0.5s ease;
  }

  @keyframes icon-bounce {
    0%, 100% { transform: translateY(0); }
    25% { transform: translateY(-8px); }
    50% { transform: translateY(-4px); }
    75% { transform: translateY(-6px); }
  }

  .service-box h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    margin-bottom: 1.25rem;
    position: relative;
    z-index: 1;
  }

  .service-box ul {
    position: relative;
    z-index: 1;
  }

  .service-box li {
    padding: 0.625rem 0 0.625rem 0.5rem;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    border-bottom: 1px solid var(--color-border);
    transition: all var(--duration-fast) ease;
    position: relative;
  }

  .service-box li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 0;
    height: 2px;
    background: var(--color-primary);
    transition: width var(--duration-fast) ease;
    opacity: 0;
  }

  .service-box:hover li::before {
    width: 4px;
    opacity: 1;
  }

  .service-box li:last-child {
    border-bottom: none;
  }

  .service-box:hover li {
    color: var(--color-text);
    padding-left: 1rem;
  }

  @media (max-width: 1024px) {
    .main-services {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      padding: 3rem 1.5rem;
    }
  }

  @media (max-width: 768px) {
    .main-services {
      grid-template-columns: 1fr;
      padding: 2.5rem 1rem;
      gap: 1rem;
    }

    .service-box {
      padding: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-box,
    .service-box li,
    .service-box::before,
    .service-box::after {
      transition: none;
    }

    .service-box:hover .service-icon {
      animation: none;
    }
  }
</style>

<script>
  import { prefersReducedMotion } from '../../scripts/motion';

  // 3D tilt follows the pointer (max 8°). Skipped for touch screens and reduced motion.
  if (!prefersReducedMotion() && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((el) => {
      el.addEventListener('mousemove', (event) => {
        const rect = el.getBoundingClientRect();
        const rotateX = ((event.clientY - rect.top - rect.height / 2) / (rect.height / 2)) * -8;
        const rotateY = ((event.clientX - rect.left - rect.width / 2) / (rect.width / 2)) * 8;
        el.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateZ(10px)`;
      });
      el.addEventListener('mouseleave', () => {
        el.style.transform = 'perspective(1000px) rotateX(0) rotateY(0) translateZ(0)';
      });
    });
  }
</script>
