---
// Round portraits with name and role lines. Used on the homepage and the clinic overview page.
import type { ImageMetadata } from 'astro';
import MediaImage from '../media/MediaImage.astro';

interface Props {
  members: ReadonlyArray<{ name: string; lines: ReadonlyArray<string>; image: ImageMetadata }>;
  /** Stagger-in animation (homepage). */
  animate?: boolean;
}

const { members, animate = false } = Astro.props;
---

<ul class="team-members">
  {members.map((member, index) => (
    <li
      class="team-member"
      data-animate={animate ? 'scale-up' : undefined}
      data-animate-delay={animate ? String(index + 1) : undefined}
    >
      <MediaImage image={{ src: member.image, alt: member.name }} sizes="180px" widths={[180, 360]} class="team-photo" />
      <h3>{member.name}</h3>
      <p>
        {member.lines.map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))}
      </p>
    </li>
  ))}
</ul>

<style>
  .team-members {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    justify-items: center;
  }

  .team-member {
    text-align: center;
    max-width: 280px;
    transition: transform var(--duration-base) ease;
  }

  .team-member:hover {
    transform: translateY(-4px);
  }

  .team-member :global(.team-photo) {
    width: 180px;
    height: 180px;
    border-radius: var(--radius-full);
    object-fit: cover;
    margin: 0 auto 1.25rem;
    border: 4px solid var(--color-primary-light);
    box-shadow: var(--shadow-md);
    transition: border-color var(--duration-base) ease;
  }

  .team-member:hover :global(.team-photo) {
    border-color: var(--color-primary);
  }

  .team-member h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.375rem;
  }

  .team-member p {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin-bottom: 0;
  }

  @media (max-width: 1024px) {
    .team-members {
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }
  }

  @media (max-width: 768px) {
    .team-members {
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 1.5rem;
    }

    .team-member :global(.team-photo) {
      width: 120px;
      height: 120px;
    }

    .team-member h3 {
      font-size: 1.1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .team-member,
    .team-member:hover {
      transition: none;
      transform: none;
    }
  }
</style>
