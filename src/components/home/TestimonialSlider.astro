---
// Horizontally scrolling quote cards with snap points, dot navigation, and auto-advance
// (paused on hover/focus, disabled for reduced motion).
interface Props {
  title: string;
  items: ReadonlyArray<{ quote: string; author: string }>;
}

const { title, items } = Astro.props;
---

<section class="testimonial-slider-section" aria-labelledby="testimonials-title" data-animate="fade-up" data-testimonials>
  <h2 class="testimonial-title" id="testimonials-title">{title}</h2>
  <div class="testimonial-wrapper">
    <div class="testimonial-slider" data-testimonial-track tabindex="0" aria-label={`${title} — scroll horizontally`}>
      {items.map((item) => (
        <figure class="testimonial-slide" data-testimonial-slide>
          <blockquote><p>"{item.quote}"</p></blockquote>
          <figcaption>- {item.author}</figcaption>
        </figure>
      ))}
    </div>
    <div class="testimonial-dots" data-testimonial-dots>
      {items.map((_, index) => (
        <button
          class:list={['testimonial-dot', index === 0 && 'active']}
          type="button"
          aria-label={`Go to testimonial ${index + 1}`}
          aria-current={index === 0 ? 'true' : undefined}
        ></button>
      ))}
    </div>
  </div>
</section>

<style>
  .testimonial-slider-section {
    background: var(--color-bg-alt);
    padding: 4rem 2rem;
  }

  .testimonial-title {
    text-align: center;
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 2.5rem;
  }

  .testimonial-slider-section.paused .testimonial-title::after {
    content: ' (Paused)';
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .testimonial-wrapper {
    max-width: var(--width-wide);
    margin: 0 auto;
    position: relative;
  }

  .testimonial-slider {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding: 1rem 0.5rem 2rem;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .testimonial-slider::-webkit-scrollbar {
    display: none;
  }

  .testimonial-slide {
    flex: 0 0 auto;
    min-width: 320px;
    max-width: 400px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2rem;
    scroll-snap-align: center;
    position: relative;
    transition: transform var(--duration-base) ease, box-shadow var(--duration-base) ease;
  }

  .testimonial-slide:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .testimonial-slide::before {
    content: '"';
    position: absolute;
    top: 1rem;
    left: 1.5rem;
    font-size: 4rem;
    font-family: var(--font-serif-accent);
    color: var(--color-primary-light);
    line-height: 1;
  }

  .testimonial-slide blockquote p {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    position: relative;
    z-index: 1;
    padding-top: 1.5rem;
  }

  .testimonial-slide figcaption {
    font-weight: 600;
    color: var(--color-primary-ink);
    margin-top: 1.25rem;
    font-size: 0.9375rem;
    position: relative;
    z-index: 1;
  }

  .testimonial-dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .testimonial-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-border);
    border: none;
    cursor: pointer;
    transition: all var(--duration-base) ease;
    padding: 0;
  }

  .testimonial-dot:hover {
    background: var(--color-primary-light);
    transform: scale(1.2);
  }

  .testimonial-dot.active {
    background: var(--color-primary);
    width: 28px;
    border-radius: 5px;
  }

  @media (max-width: 768px) {
    .testimonial-slider-section {
      padding: 3rem 1rem;
    }

    .testimonial-title {
      font-size: 1.5rem;
    }

    .testimonial-slide {
      min-width: 85vw;
      max-width: 85vw;
      padding: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .testimonial-slider {
      scroll-behavior: auto;
    }

    .testimonial-slide,
    .testimonial-dot {
      transition: none;
    }

    .testimonial-slide:hover {
      transform: none;
    }
  }
</style>

<script>
  import { prefersReducedMotion } from '../../scripts/motion';

  const section = document.querySelector<HTMLElement>('[data-testimonials]');
  const track = section?.querySelector<HTMLElement>('[data-testimonial-track]');
  const slides = track ? [...track.querySelectorAll<HTMLElement>('[data-testimonial-slide]')] : [];
  const dots = section ? [...section.querySelectorAll<HTMLButtonElement>('[data-testimonial-dots] button')] : [];

  if (section && track && slides.length) {
    let current = 0;
    let timer: number | undefined;

    const setActive = (index: number) => {
      current = index;
      dots.forEach((dot, i) => {
        dot.classList.toggle('active', i === index);
        if (i === index) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
    };

    const goTo = (index: number) => {
      const slide = slides[index];
      const left = slide.offsetLeft - track.offsetLeft - track.clientWidth / 2 + slide.offsetWidth / 2;
      track.scrollTo({ left, behavior: prefersReducedMotion() ? 'auto' : 'smooth' });
      setActive(index);
    };

    const stop = () => {
      window.clearInterval(timer);
      timer = undefined;
    };
    const start = () => {
      if (prefersReducedMotion() || timer !== undefined) return;
      timer = window.setInterval(() => goTo((current + 1) % slides.length), 4000);
    };

    dots.forEach((dot, index) => dot.addEventListener('click', () => goTo(index)));

    // Keep the dots in sync with manual swipes/scrolls.
    track.addEventListener(
      'scroll',
      () => {
        const center = track.scrollLeft + track.clientWidth / 2;
        let nearest = 0;
        slides.forEach((slide, i) => {
          const slideCenter = slide.offsetLeft - track.offsetLeft + slide.offsetWidth / 2;
          const best = slides[nearest].offsetLeft - track.offsetLeft + slides[nearest].offsetWidth / 2;
          if (Math.abs(slideCenter - center) < Math.abs(best - center)) nearest = i;
        });
        if (nearest !== current) setActive(nearest);
      },
      { passive: true },
    );

    const pause = () => {
      section.classList.add('paused');
      stop();
    };
    const resume = () => {
      section.classList.remove('paused');
      start();
    };
    section.addEventListener('mouseenter', pause);
    section.addEventListener('mouseleave', resume);
    section.addEventListener('focusin', pause);
    section.addEventListener('focusout', (event) => {
      if (!section.contains(event.relatedTarget as Node)) resume();
    });
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));

    start();
  }
</script>
