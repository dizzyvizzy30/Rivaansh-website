---
// Floating "Book Now" pill shown after the visitor scrolls past the hero (homepage only).
import Icon from '../ui/Icon.astro';
import { routes } from '../../config/navigation';
---

<a href={routes.appointment} class="floating-cta" aria-label="Book Appointment" data-floating-cta>
  <Icon name="calendar-check" />
  <span>Book Now</span>
</a>

<style>
  .floating-cta {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 1.5rem;
    background: var(--color-primary-ink);
    color: var(--color-text-on-dark);
    border-radius: var(--radius-full);
    font-weight: 600;
    font-size: 0.9375rem;
    box-shadow: 0 4px 20px rgba(143, 188, 143, 0.4);
    z-index: var(--z-floating);
    opacity: 0;
    transform: translateY(20px) scale(0.9);
    transition: all var(--duration-base) var(--ease-standard);
    pointer-events: none;
    visibility: hidden;
  }

  .floating-cta.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
    visibility: visible;
  }

  .floating-cta.is-visible.is-hidden {
    opacity: 0;
    transform: translateY(20px) scale(0.9);
    pointer-events: none;
  }

  .floating-cta :global(svg) {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .floating-cta:hover {
    background: var(--color-primary-ink-hover);
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 8px 30px rgba(143, 188, 143, 0.5);
  }

  /* Soft pulse ring */
  .floating-cta::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-full);
    background: var(--color-primary);
    animation: cta-pulse 2s ease-in-out infinite;
    z-index: -1;
  }

  @keyframes cta-pulse {
    0%, 100% {
      transform: scale(1);
      opacity: 0.5;
    }
    50% {
      transform: scale(1.15);
      opacity: 0;
    }
  }

  @media (max-width: 768px) {
    .floating-cta {
      bottom: 1.5rem;
      right: 1.5rem;
      padding: 0.875rem 1.25rem;
      font-size: 0.875rem;
    }

    .floating-cta span {
      display: none;
    }

    .floating-cta :global(svg) {
      width: 24px;
      height: 24px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .floating-cta {
      transition: opacity var(--duration-fast) linear;
      transform: none;
    }

    .floating-cta.is-visible,
    .floating-cta:hover {
      transform: none;
    }

    .floating-cta::before {
      animation: none;
      display: none;
    }
  }
</style>

<script>
  import { onFrame } from '../../scripts/motion';

  const cta = document.querySelector<HTMLElement>('[data-floating-cta]');
  const hero = document.querySelector<HTMLElement>('[data-hero]');

  if (cta && hero) {
    const mobileQuery = window.matchMedia('(max-width: 768px)');
    let lastScrollY = window.scrollY;

    const update = () => {
      const scrollY = window.scrollY;
      const heroBottom = hero.offsetTop + hero.offsetHeight;
      const visible = scrollY > heroBottom - 200;
      cta.classList.toggle('is-visible', visible);
      // On phones, tuck it away while scrolling down and bring it back on scroll up.
      cta.classList.toggle('is-hidden', visible && mobileQuery.matches && scrollY > lastScrollY && scrollY > heroBottom);
      lastScrollY = scrollY;
    };

    window.addEventListener('scroll', onFrame(update), { passive: true });
    update();
  }
</script>
