---
// Full site list for people who scroll to the bottom (and the no-JS fallback for the mobile "Menu").
import { site, formatSessions, whatsappHref } from '../../config/site';
import { routes, conditionHref } from '../../config/navigation';
import { getConditions, hasTips } from '../../data/collections';
import Icon from '../ui/Icon.astro';

const conditions = await getConditions();
const showTips = await hasTips();
const whatsapp = whatsappHref();
const { landline, email, mapsUrl } = site.contact;
const year = new Date().getFullYear();

const groups = [
  {
    label: 'Treatments',
    links: [
      ...conditions.map((c) => ({ label: c.data.title, href: conditionHref(c.id) })),
      { label: 'All conditions', href: routes.treatments },
    ],
  },
  {
    label: 'Visit & Book',
    links: [
      { label: 'Visit Us', href: routes.visit },
      { label: 'Book appointment', href: routes.book },
      { label: 'Before & after surgery', href: routes.care },
      { label: 'FAQ', href: `${routes.visit}#faq` },
    ],
  },
  {
    label: 'About',
    links: [
      { label: 'Doctor & Centre', href: routes.doctorClinic },
      ...(showTips ? [{ label: 'Health Tips', href: routes.tips }] : []),
    ],
  },
];
---

<footer class="site-footer" id="site-footer">
  <div class="footer-container">
    {groups.map((group) => (
      <nav class:list={['footer-section', { 'footer-section--treatments': group.label === 'Treatments' }]} aria-label={group.label}>
        <h2 class="footer-heading">{group.label}</h2>
        <ul class:list={{ 'footer-treatment-links': group.label === 'Treatments' }}>
          {group.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </nav>
    ))}

    <div class="footer-section footer-contact">
      <h2 class="footer-heading">Contact</h2>
      <div class="footer-address-row">
        <address>
          406, Centre Point<br />
          Vandematram-Gota, Ahmedabad<br />
          Gujarat 382470
        </address>
        <a class="footer-map-link" href={mapsUrl} target="_blank" rel="noopener" aria-label="Open Rivaansh ENT in Google Maps" title="Open in Google Maps">
          <Icon name="map-pin" />
        </a>
      </div>
      <p>{landline.label}: <a href={`tel:${landline.tel}`}>{landline.display}</a></p>
      {whatsapp && <p><a href={whatsapp} target="_blank" rel="noopener">WhatsApp</a></p>}
      <p><a href={`mailto:${email}`}>{email}</a></p>
      <ul class="footer-hours">
        {site.hours.map((h) => <li><strong>{h.label}:</strong> {formatSessions(h.sessions)}</li>)}
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <p class="footer-local" lang="gu">{site.localTagline}</p>
    <p>General information on this website is not a substitute for a consultation.</p>
    {site.doctor.registration && <p>{site.doctor.name} · Registration no. {site.doctor.registration}</p>}
    <p>&copy; {year} {site.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-surface-dark);
    color: var(--color-text-on-dark-muted);
    padding-top: 2.5rem;
    font-size: 0.9375rem;
  }

  .footer-container {
    max-width: var(--width-wide);
    margin: 0 auto;
    padding: 0 var(--gutter);
    display: grid;
    grid-template-columns: minmax(18rem, 1.65fr) minmax(9rem, 0.75fr) minmax(8rem, 0.65fr) minmax(18rem, 1.45fr);
    gap: 2rem;
  }

  .footer-heading {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-on-dark);
    margin-bottom: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .footer-section li {
    margin-bottom: 0.45rem;
  }

  .footer-treatment-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 1.5rem;
  }

  .footer-section a {
    color: var(--color-text-on-dark-muted);
    transition: color var(--duration-fast) ease;
  }

  .footer-section a:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .footer-contact p,
  .footer-contact address {
    margin-bottom: 0.5rem;
    font-style: normal;
  }

  .footer-address-row {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .footer-map-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    flex: 0 0 auto;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
  }

  .footer-map-link :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .footer-hours {
    margin-top: 0.75rem;
  }

  .footer-hours strong {
    color: var(--color-text-on-dark-soft);
    font-weight: 500;
  }

  .footer-bottom {
    margin-top: 1.75rem;
    padding: 1rem var(--gutter);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    text-align: center;
    font-size: 0.8125rem;
    display: grid;
    gap: 0.25rem;
  }

  .footer-local {
    color: var(--color-text-on-dark-soft);
    font-size: 0.9375rem;
  }

  @media (max-width: 900px) {
    .footer-container {
      grid-template-columns: 1fr 1fr;
      gap: 1.75rem 2rem;
    }

    .footer-section--treatments,
    .footer-contact {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .footer-container {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem 1rem;
      padding: 0 var(--gutter-mobile);
    }

    .footer-section--treatments,
    .footer-contact {
      grid-column: 1 / -1;
    }

    .footer-treatment-links {
      column-gap: 1rem;
    }

    .footer-bottom {
      margin-top: 1.5rem;
      padding: 1rem var(--gutter-mobile);
    }
  }
</style>
