---
// Full site list for people who scroll to the bottom (and the no-JS fallback for the mobile "Menu").
import { site, formatSessions, whatsappHref } from '../../config/site';
import { routes, conditionHref } from '../../config/navigation';
import { getConditions, hasTips } from '../../data/collections';

const conditions = await getConditions();
const showTips = await hasTips();
const whatsapp = whatsappHref();
const { phone, landline, email, address, mapsUrl } = site.contact;
const year = new Date().getFullYear();

const groups = [
  {
    label: 'Treatments',
    links: [
      ...conditions.map((c) => ({ label: c.data.title, href: conditionHref(c.id) })),
      { label: 'All conditions', href: routes.treatments },
    ],
  },
  {
    label: 'Visit & Book',
    links: [
      { label: 'Visit Us', href: routes.visit },
      { label: 'Book an appointment', href: routes.book },
      { label: 'Before & after surgery', href: routes.care },
      { label: 'FAQ', href: `${routes.visit}#faq` },
    ],
  },
  {
    label: 'About',
    links: [
      { label: 'Doctor & Clinic', href: routes.doctorClinic },
      ...(showTips ? [{ label: 'Health Tips', href: routes.tips }] : []),
    ],
  },
];
---

<footer class="site-footer" id="site-footer">
  <div class="footer-container">
    {groups.map((group) => (
      <nav class="footer-section" aria-label={group.label}>
        <h2 class="footer-heading">{group.label}</h2>
        <ul>
          {group.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </nav>
    ))}

    <div class="footer-section footer-contact">
      <h2 class="footer-heading">Contact</h2>
      <p class="footer-name">{site.name}</p>
      <address>
        {address.line1}<br />
        {address.line2}<br />
        {address.line3}
      </address>
      <p><a href={mapsUrl} target="_blank" rel="noopener">Open in Google Maps</a></p>
      <p>{phone.label}: <a href={`tel:${phone.tel}`}>{phone.display}</a></p>
      <p>{landline.label}: <a href={`tel:${landline.tel}`}>{landline.display}</a></p>
      {whatsapp && <p><a href={whatsapp} target="_blank" rel="noopener">WhatsApp</a></p>}
      <p><a href={`mailto:${email}`}>{email}</a></p>
      <ul class="footer-hours">
        {site.hours.map((h) => <li><strong>{h.label}:</strong> {formatSessions(h.sessions)}</li>)}
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <p class="footer-local" lang="gu">{site.localTagline}</p>
    <p>General information on this website is not a substitute for a consultation.</p>
    {site.doctor.registration && <p>{site.doctor.name} · Registration no. {site.doctor.registration}</p>}
    <p>&copy; {year} {site.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-surface-dark);
    color: var(--color-text-on-dark-muted);
    padding-top: 3.5rem;
    font-size: 0.9375rem;
  }

  .footer-container {
    max-width: var(--width-wide);
    margin: 0 auto;
    padding: 0 var(--gutter);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr)) minmax(0, 1.4fr);
    gap: 2.5rem;
  }

  .footer-heading {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-on-dark);
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .footer-section li {
    margin-bottom: 0.6rem;
  }

  .footer-section a {
    color: var(--color-text-on-dark-muted);
    transition: color var(--duration-fast) ease;
  }

  .footer-section a:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .footer-contact p,
  .footer-contact address {
    margin-bottom: 0.5rem;
    font-style: normal;
  }

  .footer-name {
    color: var(--color-text-on-dark);
    font-weight: 600;
  }

  .footer-hours {
    margin-top: 0.75rem;
  }

  .footer-hours strong {
    color: var(--color-text-on-dark-soft);
    font-weight: 500;
  }

  .footer-bottom {
    margin-top: 2.5rem;
    padding: 1.25rem var(--gutter);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    text-align: center;
    font-size: 0.8125rem;
    display: grid;
    gap: 0.25rem;
  }

  .footer-local {
    color: var(--color-text-on-dark-soft);
    font-size: 0.9375rem;
  }

  @media (max-width: 900px) {
    .footer-container {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .footer-container {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 0 var(--gutter-mobile);
    }

    .footer-bottom {
      padding: 1.25rem var(--gutter-mobile);
    }
  }
</style>
