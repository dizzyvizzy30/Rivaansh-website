---
// Utility strip (≥1024px) + sticky header with four plain destinations, phone and Book — no dropdowns.
// The header has one fixed height (no shrinking on scroll) and a solid background (no blur).
// Phones get a "Menu" drawer (native <dialog>: focus trap, Esc, backdrop) plus the bottom ActionBar.
import { Image } from 'astro:assets';
import logo from '../../assets/images/brand/logo.jpeg';
import Icon from '../ui/Icon.astro';
import TodayHours from './TodayHours.astro';
import { site, whatsappHref } from '../../config/site';
import { mainNav, secondaryNav, routes, sectionOf } from '../../config/navigation';
import { hasTips } from '../../data/collections';

const showTips = await hasTips();
const links = mainNav.filter((link) => !link.requiresTips || showTips);
const current = sectionOf(Astro.url.pathname);
const whatsapp = whatsappHref();
const { phone, landline, address, mapsUrl } = site.contact;
---

<div class="utility-strip">
  <div class="utility-inner">
    <span><Icon name="clock" /><TodayHours /></span>
    <a href={mapsUrl} target="_blank" rel="noopener"><Icon name="map-pin" />{address.short}</a>
    {whatsapp && <a href={whatsapp} target="_blank" rel="noopener"><Icon name="chat" />WhatsApp</a>}
  </div>
</div>

<header class="site-header">
  <a href={routes.home} class="brand" aria-label={`${site.name} — home`}>
    <Image src={logo} alt="" class="brand-logo" width={52} height={52} densities={[1, 2]} loading="eager" />
    <span class="brand-text">
      <span class="brand-name">{site.shortName}</span>
      <span class="brand-sub">{site.subName}</span>
    </span>
  </a>

  <nav class="desktop-nav" aria-label="Main">
    <ul>
      {links.map((link) => (
        <li><a href={link.href} aria-current={current === link.href ? 'page' : undefined}>{link.label}</a></li>
      ))}
    </ul>
  </nav>

  <div class="header-actions">
    <a class="header-call" href={`tel:${phone.tel}`} aria-label={`Call ${phone.display}`}>
      <Icon name="phone" />
      <span class="header-call-number">{phone.display}</span>
    </a>
    <a class="btn btn--primary header-book" href={routes.book}>Book Appointment</a>
    <a class="menu-button" href="#site-footer" aria-haspopup="dialog" aria-controls="site-drawer" data-menu-open>
      <Icon name="menu" />
      <span>Menu</span>
    </a>
  </div>
</header>

<dialog class="drawer" id="site-drawer" aria-label="Menu" data-drawer>
  <div class="drawer-head">
    <span class="drawer-title">{site.shortName}</span>
    <button class="drawer-close" type="button" data-menu-close>
      <Icon name="close" />
      <span>Close</span>
    </button>
  </div>
  <nav aria-label="Main">
    <ul class="drawer-links">
      <li><a href={routes.home} aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Home</a></li>
      {links.map((link) => (
        <li>
          <a href={link.href} aria-current={current === link.href ? 'page' : undefined}>
            {link.label}
            {link.description && <small>{link.description}</small>}
          </a>
        </li>
      ))}
    </ul>
    <ul class="drawer-secondary">
      {secondaryNav.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
    </ul>
  </nav>
  <div class="drawer-info">
    <p><Icon name="clock" /><TodayHours /></p>
    <p><Icon name="map-pin" /><span>{address.line1}, {address.line2}, {address.line3}</span></p>
    <p><a href={mapsUrl} target="_blank" rel="noopener">Open in Google Maps</a></p>
    <p><Icon name="phone" /><span>{phone.label}: <a href={`tel:${phone.tel}`}>{phone.display}</a></span></p>
    <p><Icon name="phone" /><span>{landline.label}: <a href={`tel:${landline.tel}`}>{landline.display}</a></span></p>
  </div>
</dialog>

<style>
  /* ---------- Utility strip (wide screens only) ---------- */
  .utility-strip {
    display: none;
    background: var(--color-surface-dark);
    color: var(--color-text-on-dark-soft);
    font-size: 0.8125rem;
  }

  .utility-inner {
    max-width: var(--width-bleed);
    margin: 0 auto;
    padding: 0.45rem var(--gutter);
    display: flex;
    gap: 1.75rem;
    align-items: center;
  }

  .utility-inner > * {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .utility-inner a:hover {
    color: var(--color-text-on-dark);
    text-decoration: underline;
  }

  .utility-inner :global(svg) {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  @media (min-width: 1024px) {
    .utility-strip {
      display: block;
    }
  }

  /* ---------- Header (one fixed height, solid background) ---------- */
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    height: var(--header-height);
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 0 var(--gutter);
    background: var(--color-bg);
    box-shadow: 0 1px 0 var(--color-border), 0 4px 16px rgba(30, 41, 59, 0.06);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .brand-logo {
    width: 52px;
    height: 52px;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .brand-name {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    letter-spacing: -0.02em;
  }

  .brand-sub {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .desktop-nav {
    margin-left: auto;
  }

  .desktop-nav ul {
    display: flex;
    gap: 0.25rem;
  }

  .desktop-nav a {
    display: block;
    padding: 0.5rem 0.9rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text);
    border-radius: var(--radius-sm);
    transition: background-color var(--duration-fast) ease, color var(--duration-fast) ease;
  }

  .desktop-nav a:hover,
  .desktop-nav a[aria-current='page'] {
    background: var(--color-primary-light);
    color: var(--color-primary-ink);
  }

  .desktop-nav a[aria-current='page'] {
    font-weight: 600;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .header-call {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
    color: var(--color-primary-ink);
    white-space: nowrap;
  }

  .header-call :global(svg) {
    width: 18px;
    height: 18px;
  }

  .header-call:hover .header-call-number {
    text-decoration: underline;
  }

  .header-book.btn {
    padding: 0.55rem 1.25rem;
    font-size: 0.9375rem;
    box-shadow: none;
  }

  .header-book.btn:hover {
    transform: none;
    box-shadow: none;
  }

  .menu-button {
    display: none;
  }

  /* 769–1023px: shorter wordmark, phone becomes an icon button */
  @media (max-width: 1023px) {
    .brand-sub {
      display: none;
    }

    .header-call-number {
      display: none;
    }

    .header-call {
      width: 44px;
      height: 44px;
      justify-content: center;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-full);
    }

    .desktop-nav a {
      padding: 0.5rem 0.6rem;
    }
  }

  /* ≤768px: logo + name, Call icon, "Menu" button; booking lives in the bottom action bar */
  @media (max-width: 768px) {
    .site-header {
      height: var(--header-height-compact);
      padding: 0 var(--gutter-mobile);
      gap: 0.75rem;
    }

    .brand-logo {
      width: 40px;
      height: 40px;
    }

    .brand-name {
      font-size: 1.125rem;
    }

    .desktop-nav,
    .header-book {
      display: none;
    }

    .header-actions {
      margin-left: auto;
      gap: 0.5rem;
    }

    .menu-button {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      height: 44px;
      padding: 0 1rem;
      border-radius: var(--radius-full);
      background: var(--color-primary-ink);
      color: var(--color-text-on-dark);
      font-weight: 600;
    }

    .menu-button :global(svg) {
      width: 18px;
      height: 18px;
    }
  }

  /* ---------- Drawer ---------- */
  .drawer {
    margin: 0 0 0 auto;
    width: min(360px, 88vw);
    max-width: none;
    height: 100dvh;
    max-height: none;
    border: 0;
    padding: 0 1.25rem 2rem;
    background: var(--color-bg);
    color: var(--color-text);
    overflow-y: auto;
    box-shadow: -8px 0 30px rgba(15, 23, 42, 0.2);
  }

  .drawer::backdrop {
    background: rgba(15, 23, 42, 0.45);
  }

  .drawer-head {
    position: sticky;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height-compact);
    background: var(--color-bg);
  }

  .drawer-title {
    font-weight: 700;
    color: var(--color-primary-dark);
    font-size: 1.125rem;
  }

  .drawer-close {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 44px;
    padding: 0 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-bg);
    color: var(--color-text);
    font-weight: 600;
    cursor: pointer;
  }

  .drawer-close :global(svg) {
    width: 18px;
    height: 18px;
  }

  .drawer-links a {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 56px;
    padding: 0.5rem 0.75rem;
    font-size: 1.125rem;
    font-weight: 600;
    border-bottom: 1px solid var(--color-border);
  }

  .drawer-links small {
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .drawer-links a[aria-current='page'] {
    color: var(--color-primary-ink);
    background: var(--color-primary-light);
    border-radius: var(--radius-sm);
  }

  .drawer-secondary {
    margin-top: 1rem;
  }

  .drawer-secondary a {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding: 0 0.75rem;
    font-size: 1rem;
    color: var(--color-primary-ink);
    font-weight: 600;
  }

  .drawer-info {
    margin-top: 1.25rem;
    padding: 1rem 0.75rem 0;
    border-top: 1px solid var(--color-border);
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }

  .drawer-info p {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    margin-bottom: 0.75rem;
  }

  .drawer-info :global(svg) {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    margin-top: 0.2rem;
    color: var(--color-primary-dark);
  }

  .drawer-info a {
    color: var(--color-primary-ink);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .drawer[open] {
      animation: drawer-in var(--duration-base) var(--ease-standard);
    }

    @keyframes drawer-in {
      from { transform: translateX(100%); }
      to { transform: translateX(0); }
    }
  }
</style>

<script>
  const drawer = document.querySelector<HTMLDialogElement>('[data-drawer]');
  const openers = document.querySelectorAll<HTMLAnchorElement>('[data-menu-open]');

  if (drawer && typeof drawer.showModal === 'function') {
    openers.forEach((opener) => {
      opener.setAttribute('role', 'button');
      opener.addEventListener('click', (event) => {
        event.preventDefault();
        drawer.showModal();
      });
    });
    drawer.querySelector('[data-menu-close]')?.addEventListener('click', () => drawer.close());
    // Tapping the backdrop (outside the panel) closes the menu.
    drawer.addEventListener('click', (event) => {
      if (event.target === drawer) drawer.close();
    });
    drawer.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => drawer.close()));
    window.matchMedia('(min-width: 769px)').addEventListener('change', (e) => {
      if (e.matches) drawer.close();
    });
  }
</script>
