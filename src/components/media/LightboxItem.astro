---
// Wraps a thumbnail in a link to the full-size media and registers it with the nearest [data-lightbox]
// container. Without JS the link simply opens the full image/video.
import { getImage } from 'astro:assets';
import type { MediaItem } from './types';
import { PHOTO_FORMAT, PHOTO_QUALITY, metaOf, widthsFor } from './photo-sizes';

interface Props {
  item: MediaItem;
}

const { item } = Astro.props;

let href: string;
let width: number;
let height: number;
let srcset: string | undefined;

if (item.kind === 'image') {
  // Same variants as the page image (no extra files); the largest one is the full-screen view.
  const meta = metaOf(item.src);
  const widths = widthsFor(meta.width);
  const largest = Math.max(...widths);
  const full = await getImage({ src: item.src, width: largest, widths, format: PHOTO_FORMAT, quality: PHOTO_QUALITY });
  href = full.src;
  srcset = full.srcSet.attribute || undefined;
  width = largest;
  height = Math.round((meta.height / meta.width) * largest);
} else {
  const poster = metaOf(item.poster);
  href = item.src;
  width = poster.width;
  height = poster.height;
}
---

<a
  class="lightbox-item"
  href={href}
  data-lightbox-item
  data-pswp-width={width}
  data-pswp-height={height}
  data-pswp-srcset={srcset}
  data-caption={item.caption}
  data-type={item.kind}
  aria-haspopup="dialog"
>
  <slot />
</a>

<style>
  .lightbox-item {
    display: block;
    cursor: zoom-in;
    border-radius: inherit;
  }

  .lightbox-item[data-type='video'] {
    cursor: pointer;
  }
</style>

<style is:global>
  /* PhotoSwipe theme + caption/video additions (its DOM lives outside this component).
     `html .pswp` outranks photoswipe.css, which is loaded later on first open. */
  html .pswp {
    --pswp-bg: #0f172a;
    --pswp-placeholder-bg: #1e293b;
    --pswp-icon-color: #ffffff;
    --pswp-icon-color-secondary: #1e293b;
    font-family: var(--font-sans);
  }

  .pswp__button:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: -3px;
  }

  .pswp__caption {
    position: absolute;
    left: 50%;
    bottom: max(1rem, env(safe-area-inset-bottom));
    transform: translateX(-50%);
    width: min(42rem, calc(100% - 2rem));
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    background: rgba(15, 23, 42, 0.72);
    color: #f8fafc;
    font-size: 0.9375rem;
    line-height: 1.5;
    text-align: center;
    pointer-events: none;
  }

  .pswp__caption[hidden] {
    display: none;
  }

  .pswp__video-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #000000;
  }

  .pswp__video-wrap video {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>

<script>
  import '../../scripts/lightbox';
</script>
