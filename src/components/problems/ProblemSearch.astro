---
import { problemCategories, problemFinderItems } from '../../data/problem-finder';
import { site } from '../../config/site';
---

<section class="problem-search" aria-labelledby="problem-search-title" data-problem-search>
  <div class="search-panel">
    <h2 id="problem-search-title">What have you noticed?</h2>
    <p>Use everyday words such as “ear leaking”, “hearing less”, “dizzy” or “child snoring”.</p>
    <label for="problem-query">Search symptoms and concerns</label>
    <div class="search-row">
      <input id="problem-query" type="search" inputmode="search" autocomplete="off" maxlength="120" placeholder="For example: blocked nose" data-problem-query />
      <button type="button" class="clear-button" data-problem-clear>Clear</button>
    </div>
    <div class="filters" aria-label="Filter by area">
      {problemCategories.map((category, index) => (
        <button type="button" class:list={['filter', index === 0 && 'is-active']} aria-pressed={index === 0 ? 'true' : 'false'} data-problem-filter={category}>
          {category}
        </button>
      ))}
    </div>
  </div>

  <p class="result-count" aria-live="polite" data-result-count>{problemFinderItems.length} topics shown</p>

  <ul class="problem-results" data-problem-results>
    {problemFinderItems.map((problem) => (
      <li
        id={problem.id}
        class="problem-result"
        data-problem-item
        data-category={problem.category}
        data-search={[problem.title, problem.gujarati, problem.category, problem.summary, ...problem.aliases].filter(Boolean).join(' ').toLowerCase()}
      >
        <div>
          <p class="problem-category">{problem.category}</p>
          <h3>{problem.title}</h3>
          {problem.gujarati && <p class="problem-gujarati" lang="gu">{problem.gujarati}</p>}
          <p>{problem.summary}</p>
        </div>
        <a href={problem.href}>See related centre information</a>
      </li>
    ))}
  </ul>

  <div class="no-match" data-no-match hidden>
    <h3>No close match on this website</h3>
    <p>That does not mean the centre cannot help. Call and describe what you have noticed.</p>
  </div>

  <aside class="finder-call" aria-label="Call the centre">
    <div>
      <h2>Still unsure?</h2>
      <p>This finder only matches your words with topics listed on this website. It does not diagnose a condition.</p>
    </div>
    <a class="btn btn--primary" href={`tel:${site.contact.landline.tel}`} aria-label={`Call Rivaansh ENT at ${site.contact.landline.display}`}>Call us</a>
  </aside>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-problem-search]').forEach((root) => {
    const query = root.querySelector<HTMLInputElement>('[data-problem-query]');
    const clear = root.querySelector<HTMLButtonElement>('[data-problem-clear]');
    const filters = [...root.querySelectorAll<HTMLButtonElement>('[data-problem-filter]')];
    const items = [...root.querySelectorAll<HTMLElement>('[data-problem-item]')];
    const count = root.querySelector<HTMLElement>('[data-result-count]');
    const noMatch = root.querySelector<HTMLElement>('[data-no-match]');
    if (!query || !clear || !count || !noMatch) return;

    let category = 'All';
    const normalize = (value: string) => value.toLocaleLowerCase().trim().replace(/\s+/g, ' ');

    const update = () => {
      const words = normalize(query.value).split(' ').filter(Boolean);
      let visible = 0;
      items.forEach((item) => {
        const matchesCategory = category === 'All' || item.dataset.category === category;
        const haystack = item.dataset.search ?? '';
        const matchesWords = words.length === 0 || words.every((word) => haystack.includes(word));
        item.hidden = !(matchesCategory && matchesWords);
        if (!item.hidden) visible += 1;
      });
      count.textContent = `${visible} ${visible === 1 ? 'topic' : 'topics'} shown`;
      noMatch.hidden = visible !== 0;
      clear.hidden = query.value.length === 0 && category === 'All';
    };

    filters.forEach((button) => button.addEventListener('click', () => {
      category = button.dataset.problemFilter ?? 'All';
      filters.forEach((item) => {
        const active = item === button;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-pressed', String(active));
      });
      update();
    }));

    query.addEventListener('input', update);
    clear.addEventListener('click', () => {
      query.value = '';
      category = 'All';
      filters.forEach((item, index) => {
        item.classList.toggle('is-active', index === 0);
        item.setAttribute('aria-pressed', String(index === 0));
      });
      update();
      query.focus();
    });

    const initialQuery = new URLSearchParams(location.search).get('q');
    if (initialQuery) {
      query.value = initialQuery.slice(0, 120);
    } else if (location.hash) {
      const selected = document.getElementById(decodeURIComponent(location.hash.slice(1)));
      if (selected?.hasAttribute('data-problem-item')) {
        query.value = selected.querySelector('h3')?.textContent?.trim() ?? '';
      }
    }
    update();
  });
</script>

<style>
  .problem-search {
    margin-top: 2rem;
  }

  .search-panel {
    max-width: 70rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border-radius: var(--radius-xl);
    background: var(--color-primary-light);
  }

  .search-panel h2 {
    margin-bottom: 0.35rem;
  }

  .search-panel > p {
    margin-bottom: 1rem;
    color: var(--color-text-muted);
  }

  .search-panel label {
    display: block;
    margin-bottom: 0.4rem;
    color: var(--color-primary-dark);
    font-weight: 700;
  }

  .search-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.65rem;
  }

  .search-row input {
    min-height: 52px;
    padding: 0.75rem 1rem;
    border: 2px solid var(--color-field-border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
  }

  .search-row input:focus {
    border-color: var(--color-secondary);
    outline: 3px solid rgba(18, 103, 155, 0.18);
  }

  .clear-button,
  .filter {
    min-height: 44px;
    padding: 0.55rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-bg);
    color: var(--color-primary-ink);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .filter.is-active {
    border-color: var(--color-primary-ink);
    background: var(--color-primary-ink);
    color: var(--color-text-on-dark);
  }

  .result-count {
    margin: 1.5rem 0 0.75rem;
    color: var(--color-text-muted);
    font-weight: 650;
  }

  .problem-results {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .problem-result {
    min-width: 0;
    padding: 1.35rem;
    display: grid;
    align-content: space-between;
    gap: 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg);
  }

  .problem-result[hidden] {
    display: none;
  }

  .problem-category {
    margin-bottom: 0.25rem;
    color: var(--color-primary-ink);
    font-size: 0.8125rem;
    font-weight: 750;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .problem-result h3 {
    margin-bottom: 0.4rem;
    color: var(--color-primary-dark);
    font-size: 1.2rem;
  }

  .problem-gujarati {
    margin: -0.1rem 0 0.5rem;
    color: var(--color-primary-ink);
    font-size: 0.95rem;
    font-weight: 650;
  }

  .problem-result p:not(.problem-category):not(.problem-gujarati) {
    color: var(--color-text-muted);
    font-size: 1rem;
  }

  .problem-result a {
    color: var(--color-primary-ink);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .no-match {
    max-width: 50rem;
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    background: var(--color-bg-alt);
  }

  .finder-call {
    margin-top: 2.5rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.5rem;
    align-items: center;
    border-radius: var(--radius-xl);
    background: var(--color-surface-dark);
    color: var(--color-text-on-dark-soft);
  }

  .finder-call h2 {
    color: var(--color-text-on-dark);
  }

  .finder-call p {
    margin: 0;
    color: var(--color-text-on-dark-soft);
  }

  @media (max-width: 1100px) {
    .problem-results {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .search-row,
    .problem-results,
    .finder-call {
      grid-template-columns: 1fr;
    }

    .clear-button {
      justify-self: start;
    }
  }
</style>
