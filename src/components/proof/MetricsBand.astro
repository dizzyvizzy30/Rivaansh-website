---
// Clinic numbers. Live site: only confirmed numbers with a stated source (nothing at all if none).
// Preview builds: every number, unconfirmed ones outlined in amber with a note for the owner.
import InfoNeeded from '../ui/InfoNeeded.astro';
import { metrics, liveMetrics, proofSections } from '../../data/proof';
import { showDrafts } from '../../data/collections';

interface Props {
  /** `band` = slim strip under the homepage hero; `detail` = Doctor & Clinic, with sources shown. */
  variant?: 'band' | 'detail';
}

const { variant = 'band' } = Astro.props;
const items = showDrafts ? metrics : liveMetrics();
---

{items.length > 0 && (
  <section class:list={['metrics', `metrics--${variant}`]} id={variant === 'detail' ? 'numbers' : undefined} aria-label={proofSections.metricsTitle}>
    {variant === 'detail' && <h2>{proofSections.metricsTitle}</h2>}
    <dl class="metrics-list">
      {items.map((m) => {
        const pending = !(m.confirmed && m.source);
        return (
          <div class:list={['metric', pending && 'metric--pending']}>
            <dt>{m.label}{m.note && <small> ({m.note})</small>}</dt>
            <dd>{m.value}</dd>
            {variant === 'detail' && m.source && !pending && <p class="metric-source">Source: {m.source}</p>}
            {pending && <InfoNeeded what="confirm this number and how it was counted" folder="07-numbers-and-reviews" />}
          </div>
        );
      })}
    </dl>
  </section>
)}

<style>
  .metrics--band {
    background: var(--color-bg-alt);
    padding: 2rem var(--gutter);
  }

  .metrics--detail {
    margin-top: 2.5rem;
  }

  .metrics--detail h2 {
    margin-bottom: 1rem;
  }

  .metrics-list {
    max-width: var(--width-wide);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr));
    gap: 1rem;
  }

  /* Number above label visually; label (dt) first in the DOM for screen readers. */
  .metric {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    padding: 1.25rem 1.5rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    text-align: center;
  }

  .metric--pending {
    border: 2px dashed #f3c56b;
    background: #fffbf2;
  }

  .metric dd {
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1.1;
    color: var(--color-primary-dark);
    letter-spacing: -0.02em;
  }

  .metric dt {
    margin-top: 0.35rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .metric dt small {
    font-size: 0.85em;
  }

  .metric-source {
    order: -1;
    margin-top: 0.4rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .metric :global(.info-needed) {
    order: -2;
    margin-top: 0.5rem;
    align-self: center;
  }

  @media (max-width: 768px) {
    .metrics--band {
      padding: 1.5rem var(--gutter-mobile);
    }

    .metrics-list {
      grid-template-columns: repeat(auto-fit, minmax(min(140px, 100%), 1fr));
      gap: 0.75rem;
    }

    .metric {
      padding: 1rem;
    }

    .metric dd {
      font-size: 1.75rem;
    }
  }
</style>
