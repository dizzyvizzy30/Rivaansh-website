---
// Conditions grouped by body area. Items whose condition page is published become links; the rest stay plain
// text (never a dead link). `chips` on Home, `list` on the Treatments hub.
import Icon from '../ui/Icon.astro';
import { treatmentGroups } from '../../data/treatments';
import { conditionHref } from '../../config/navigation';
import { getConditions } from '../../data/collections';

interface Props {
  variant?: 'chips' | 'list';
}

const { variant = 'list' } = Astro.props;
const published = new Set((await getConditions()).map((c) => c.id));
---

<div class:list={['condition-groups', `condition-groups--${variant}`]}>
  {treatmentGroups.map((group) => (
    <section class="condition-group" id={variant === 'list' ? group.id : undefined} aria-labelledby={`group-${variant}-${group.id}`}>
      <h3 id={`group-${variant}-${group.id}`} class="group-title">
        <Icon name={group.icon} />
        {group.title}
      </h3>
      <ul>
        {group.items.map((item) => (
          <li>
            {item.slug && published.has(item.slug) ? (
              <a href={conditionHref(item.slug)}>{item.name}</a>
            ) : (
              <span>{item.name}</span>
            )}
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<style>
  .condition-groups {
    display: grid;
    gap: 1.25rem;
  }

  .condition-groups--chips {
    grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr));
    gap: 1rem;
  }

  .condition-groups--chips .condition-group {
    padding: 1.25rem;
  }

  .condition-groups--list {
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
  }

  .condition-group {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    position: relative;
    overflow: hidden;
  }

  .condition-group::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 4px;
    background: linear-gradient(180deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  }

  .group-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.1875rem;
    color: var(--color-primary-dark);
    margin-bottom: 1rem;
  }

  .group-title :global(svg) {
    width: 32px;
    height: 32px;
    color: var(--color-primary);
    flex-shrink: 0;
  }

  /* Chips (homepage) */
  .condition-groups--chips ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .condition-groups--chips li > * {
    display: inline-block;
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-full);
    font-size: 0.9375rem;
    border: 1px solid var(--color-border);
    color: var(--color-text);
  }

  .condition-groups--chips li > a {
    border-color: var(--color-primary);
    color: var(--color-primary-ink);
    font-weight: 600;
  }

  .condition-groups--chips li > a:hover {
    background: var(--color-primary-light);
  }

  /* List (hub) */
  .condition-groups--list li {
    border-bottom: 1px solid var(--color-border);
  }

  .condition-groups--list li:last-child {
    border-bottom: 0;
  }

  .condition-groups--list li > * {
    display: block;
    padding: 0.65rem 0;
  }

  .condition-groups--list li > span {
    color: var(--color-text-muted);
  }

  .condition-groups--list li > a {
    color: var(--color-primary-ink);
    font-weight: 600;
  }

  .condition-groups--list li > a::after {
    content: ' →';
  }

  .condition-groups--list li > a:hover {
    text-decoration: underline;
  }
</style>
