---
// Responsive grid of white cards with a green title and short text (specialities, surgeries).
interface Props {
  items: ReadonlyArray<{ title: string; text: string }>;
}

const { items } = Astro.props;
---

<ul class="info-cards">
  {items.map((item) => (
    <li class="info-card">
      <h2>{item.title}</h2>
      <p>{item.text}</p>
    </li>
  ))}
</ul>

<style>
  .info-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 2em;
    margin-top: 2em;
  }

  .info-card {
    background: var(--color-bg);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    padding: 2em;
  }

  .info-card h2 {
    font-size: 1.5em;
    color: var(--color-primary-dark);
    margin-bottom: 1em;
  }

  .info-card p {
    font-size: 1em;
    line-height: 1.6;
    color: var(--color-text);
  }
</style>
