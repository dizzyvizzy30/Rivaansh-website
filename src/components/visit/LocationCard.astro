---
// Building photo + address, landmarks, hours and a Google Maps button (Home and Visit Us).
import MediaImage from '../media/MediaImage.astro';
import HoursTable from './HoursTable.astro';
import Icon from '../ui/Icon.astro';
import { site } from '../../config/site';
import { visitPage } from '../../data/visit';

const { address, mapsUrl, phone, landline } = site.contact;
---

<div class="location-card">
  <a class="location-photo" href={mapsUrl} target="_blank" rel="noopener" aria-label="Open the clinic location in Google Maps">
    <MediaImage image={visitPage.building} sizes="(max-width: 900px) calc(100vw - 2rem), 560px" />
  </a>
  <div class="location-body">
    <h3 class="location-name">{site.name}</h3>
    <address>
      {address.line1}<br />
      {address.line2}<br />
      {address.line3}
    </address>
    <ul class="location-notes">
      {visitPage.gettingThere.map((note) => <li>{note}</li>)}
    </ul>
    <HoursTable />
    <ul class="location-phones">
      <li><Icon name="phone" />{phone.label}: <a href={`tel:${phone.tel}`}>{phone.display}</a></li>
      <li><Icon name="phone" />{landline.label}: <a href={`tel:${landline.tel}`}>{landline.display}</a></li>
    </ul>
    <a class="btn btn--primary" href={mapsUrl} target="_blank" rel="noopener">
      <Icon name="map-pin" />
      Open in Google Maps
    </a>
  </div>
</div>

<style>
  .location-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }

  .location-photo {
    display: block;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .location-photo :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .location-name {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }

  address {
    font-style: normal;
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .location-notes {
    margin-bottom: 1.25rem;
    color: var(--color-text-muted);
  }

  .location-notes li {
    padding-left: 1rem;
    position: relative;
    margin-bottom: 0.35rem;
  }

  .location-notes li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-primary);
  }

  .location-phones {
    margin: 1.25rem 0;
  }

  .location-phones li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
    flex-wrap: wrap;
  }

  .location-phones a {
    font-weight: 600;
    color: var(--color-primary-ink);
  }

  .location-card :global(svg) {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .location-phones :global(svg) {
    color: var(--color-primary-dark);
  }

  .location-body .btn {
    box-shadow: none;
  }

  @media (max-width: 900px) {
    .location-card {
      grid-template-columns: 1fr;
    }
  }
</style>
