---
import '@fontsource-variable/inter';
import interLatinUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '../styles/global.css';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import ActionBar from '../components/layout/ActionBar.astro';
import { site } from '../config/site';

interface Props {
  /** Page name, shown as "<title> | Rivaansh ENT". Omit on the homepage. */
  title?: string;
  description?: string;
  /** Keep the page out of search results (drafts, 404). */
  noindex?: boolean;
  /** Add MedicalClinic structured data (homepage and Visit Us). */
  clinicSchema?: boolean;
}

const { title, description = site.description, noindex = false, clinicSchema = false } = Astro.props;
const fullTitle = title ? `${title} | ${site.shortName}` : `${site.name} — Gota, Ahmedabad`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;

const dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const schema = clinicSchema && {
  '@context': 'https://schema.org',
  '@type': 'MedicalClinic',
  name: site.name,
  medicalSpecialty: 'Otolaryngologic',
  telephone: site.contact.phone.tel,
  email: site.contact.email,
  ...(Astro.site && { url: Astro.site.href }),
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.contact.address.street,
    addressLocality: site.contact.address.locality,
    addressRegion: site.contact.address.region,
    postalCode: site.contact.address.postalCode,
    addressCountry: site.contact.address.country,
  },
  openingHoursSpecification: site.hours.flatMap((h) =>
    h.sessions.map((s) => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: h.days.map((d) => dayNames[d]),
      opens: s.open,
      closes: s.close,
    })),
  ),
  employee: { '@type': 'Physician', name: site.doctor.name },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#ffffff" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={interLatinUrl} as="font" type="font/woff2" crossorigin />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <ActionBar />
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
