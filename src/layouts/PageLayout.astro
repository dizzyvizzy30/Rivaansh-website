---
// Simple inner page: shared chrome + the 960px `.page-container` column.
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  clinicSchema?: boolean;
}

const props = Astro.props;
---

<BaseLayout {...props}>
  <div class="page-container">
    <slot />
  </div>
</BaseLayout>
