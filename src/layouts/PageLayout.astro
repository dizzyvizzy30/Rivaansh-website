---
// Inner page shell. Wide hub pages can use the full site canvas while article-style pages keep a reading measure.
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  clinicSchema?: boolean;
  variant?: 'wide' | 'reading';
}

const { variant = 'reading', ...props } = Astro.props;
---

<BaseLayout {...props}>
  <div class:list={['page-container', `page-container--${variant}`]}>
    <slot />
  </div>
</BaseLayout>
