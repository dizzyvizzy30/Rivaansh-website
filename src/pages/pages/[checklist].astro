---
// Unlisted owner shot list + facts list: /pages/photos-needed.html
// It is generated on every build, marked noindex, and never linked from the public navigation.
import PageLayout from '../../layouts/PageLayout.astro';
import PhotoSlot from '../../components/media/PhotoSlot.astro';
import { ownerPhotoFolder, photoSlots, slotStatus, type SlotStatus } from '../../data/photo-slots';
import { factsNeeded } from '../../data/facts-needed';

export function getStaticPaths() {
  return [{ params: { checklist: 'photos-needed' } }];
}

const groups: { status: SlotStatus; title: string }[] = [
  { status: 'missing', title: 'Missing' },
  { status: 'stand-in', title: 'Using a stand-in photo (please replace)' },
  { status: 'real', title: 'Done' },
];
const levelLabel = { required: 'Required', conditional: 'Only if this exists at the centre', optional: 'Optional' };
const missingCount = photoSlots.filter((s) => slotStatus(s.id) !== 'real').length;
const facts = factsNeeded();
---

<PageLayout title="Owner photo checklist" noindex>
  <h1>Owner photo checklist</h1>
  <p>
    {missingCount} of {photoSlots.length} photo spots still need a real photo. Add each photo to the page folder shown with that item.
    The photo folders are grouped by the website page they support. This page is unlisted and is not linked from the patient navigation.
  </p>
  <p class="tips">
    Daylight · lights on · phone at eye level · wipe the lens · three takes of each · no patients and no patient data on screens ·
    staff only with their consent · send the original files, not WhatsApp copies.
  </p>

  {groups.map(({ status, title }) => {
    const slots = photoSlots.filter((s) => slotStatus(s.id) === status);
    return slots.length > 0 && (
      <section class="group">
        <h2>{title} ({slots.length})</h2>
        <ol class="slots">
          {slots.map((slot) => (
            <li class="slot">
              <PhotoSlot id={slot.id} sizes="(max-width: 640px) 100vw, 260px" reviewMode />
              <div class="slot-body">
                <h3><code>{slot.id}</code></h3>
                <p><strong>{slot.title}.</strong> {slot.brief}</p>
                <p class="meta">Upload to: <code>{ownerPhotoFolder(slot.id)}</code></p>
                <p class="meta">{slot.orientation === 'landscape' ? 'Landscape - hold the phone sideways' : 'Portrait - hold the phone upright'} · at least {slot.minSize} · {levelLabel[slot.level]}</p>
                <p class="meta">Used on: {slot.usedOn.map((u, i) => <>{i > 0 && ' · '}<a href={u.href}>{u.label}</a></>)}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>
    );
  })}

  {facts.length > 0 && (
    <section class="group">
      <h2>Facts still needed ({facts.length})</h2>
      <ul class="facts">{facts.map((f) => <li>{f.what} <span class="meta">→ owner-content/{f.folder}</span></li>)}</ul>
    </section>
  )}
</PageLayout>

<style>
  .tips {
    padding: 1rem 1.25rem;
    border-radius: var(--radius-md);
    background: var(--color-bg-alt);
  }

  .group {
    margin-top: 2.5rem;
  }

  .group h2 {
    margin-bottom: 1rem;
  }

  .slot {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 1.5rem;
    align-items: start;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .slot-body h3 {
    margin-bottom: 0.4rem;
  }

  .slot-body p {
    font-size: 1rem;
    margin-bottom: 0.4rem;
  }

  .meta {
    color: var(--color-text-muted);
  }

  .meta a {
    color: var(--color-primary-ink);
  }

  .facts li {
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  @media (max-width: 640px) {
    .slot {
      grid-template-columns: 1fr;
    }
  }
</style>
