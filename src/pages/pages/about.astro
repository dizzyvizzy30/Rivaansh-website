---
import PageLayout from '../../layouts/PageLayout.astro';
import SpecialistGrid from '../../components/home/SpecialistGrid.astro';
import { aboutClinicOverview as page } from '../../data/about-clinic-overview';
---

<PageLayout title="About Us">
  <h1>{page.title}</h1>
  <p>{page.intro}</p>
  <section class="overview-section" aria-labelledby="overview-services">
    <h2 id="overview-services">{page.servicesHeading}</h2>
    <ul class="service-columns">
      {page.services.map((service) => <li>{service}</li>)}
    </ul>
  </section>
  <section class="overview-section" aria-labelledby="overview-doctors">
    <h2 id="overview-doctors">{page.doctorsHeading}</h2>
    <SpecialistGrid members={page.doctors} />
  </section>
</PageLayout>

<style>
  .overview-section {
    margin-top: 2em;
  }

  .service-columns {
    columns: 2;
    max-width: 700px;
    margin: auto;
  }
</style>
