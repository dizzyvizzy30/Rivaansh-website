---
// Book (old URL kept) - a task page: how to call, what to have ready. No timings table, no photos.
// Old online-consultation.html redirects here. The request form returns in Phase 2.
import PageLayout from '../../layouts/PageLayout.astro';
import ContactActions from '../../components/ui/ContactActions.astro';
import TodayHours from '../../components/layout/TodayHours.astro';
import InfoNeeded from '../../components/ui/InfoNeeded.astro';
import { bookPage as page } from '../../data/book';
import { site } from '../../config/site';
import { routes } from '../../config/navigation';

const { phone, landline } = site.contact;
---

<PageLayout title="Book an appointment" description="Call Rivaansh ENT, Gota, Ahmedabad to book, change or cancel an ENT appointment.">
  <h1>{page.title}</h1>
  <p>{page.intro}</p>

  <div class="book-card">
    <p class="call-when"><TodayHours prefix="Call today" separator=" - " /></p>
    <ContactActions whatsappText="Hello, I would like to book an appointment at Rivaansh ENT. It is for: (me / my child / my parent). Age: . Problem: . Preferred day: ." />
    <ul class="numbers">
      <li>{phone.label}: <a href={`tel:${phone.tel}`}>{phone.display}</a></li>
      <li>{landline.label}: <a href={`tel:${landline.tel}`}>{landline.display}</a></li>
    </ul>
    <p class="ready">{page.haveReady}</p>
    {page.afterYouCall ? <p>{page.afterYouCall}</p> : <InfoNeeded what="what happens after you call (fixed time, token, walk-in?)" folder="06-faq" />}
  </div>

  <p><a href={`${routes.visit}#first-visit`}>What happens at your first visit, and what to bring</a></p>
  <p><a href={`${routes.visit}#timings`}>Full weekly timings and address</a></p>
</PageLayout>

<style>
  .book-card {
    padding: 1.75rem;
    border-radius: var(--radius-lg);
    background: var(--color-primary-light);
    margin: 1.5rem 0 2rem;
  }

  .call-when {
    font-weight: 600;
  }

  .numbers {
    margin: 1.25rem 0 1rem;
  }

  .numbers li {
    margin-bottom: 0.4rem;
  }

  .numbers a {
    font-weight: 600;
    color: var(--color-primary-ink);
  }

  .ready {
    font-weight: 600;
  }
</style>
