---
// Book (old URL kept). Old online-consultation.html redirects here.
// The request form returns in Phase 2 once it can deliver to WhatsApp / Google Sheet.
import PageLayout from '../../layouts/PageLayout.astro';
import ContactActions from '../../components/ui/ContactActions.astro';
import HoursTable from '../../components/visit/HoursTable.astro';
import { bookPage as page } from '../../data/book';
import { firstVisit } from '../../data/visit';
import { site } from '../../config/site';
import { routes } from '../../config/navigation';

const { phone, landline } = site.contact;
---

<PageLayout title="Book an Appointment" description="Call Rivaansh ENT, Gota, Ahmedabad to book or change an ENT appointment.">
  <h1>{page.title}</h1>
  <p>{page.intro}</p>

  <div class="book-card">
    <ContactActions />
    <p class="numbers">
      {phone.label}: <a href={`tel:${phone.tel}`}>{phone.display}</a><br />
      {landline.label}: <a href={`tel:${landline.tel}`}>{landline.display}</a>
    </p>
    <p>{page.rescheduling}</p>
  </div>

  <h2>Timings</h2>
  <HoursTable />

  <h2>What to bring</h2>
  <ul class="ticks">{firstVisit.bring.map((item) => <li>{item}</li>)}</ul>
  <p><a href={`${routes.visit}#first-visit`}>What happens at your first visit</a></p>
</PageLayout>

<style>
  .book-card {
    padding: 1.75rem;
    border-radius: var(--radius-lg);
    background: var(--color-primary-light);
    margin: 1.5rem 0 2.5rem;
  }

  .numbers {
    margin-top: 1.25rem;
  }

  .numbers a {
    font-weight: 600;
    color: var(--color-primary-ink);
  }

  h2 {
    margin: 2rem 0 0.75rem;
  }

  .ticks li {
    padding: 0.35rem 0 0.35rem 1.5rem;
    position: relative;
  }

  .ticks li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--color-primary-dark);
    font-weight: 700;
  }
</style>
