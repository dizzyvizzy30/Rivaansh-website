---
// Health tip page. Each tip links to 1–3 condition pages (and they link back).
import { render } from 'astro:content';
import PageLayout from '../../../layouts/PageLayout.astro';
import PostCover from '../../../components/blog/PostCover.astro';
import ContactActions from '../../../components/ui/ContactActions.astro';
import { getTips, getConditions, reviewLine, type Tip } from '../../../data/collections';
import { conditionHref, routes } from '../../../config/navigation';
import { site } from '../../../config/site';

export async function getStaticPaths() {
  const tips = await getTips();
  return tips.map((tip) => ({ params: { slug: tip.id }, props: { tip } }));
}

interface Props {
  tip: Tip;
}

const { tip } = Astro.props;
const { data } = tip;
const { Content } = await render(tip);
const related = (await getConditions()).filter((c) => data.relatedConditions.includes(c.id) || c.data.relatedTips.includes(tip.id));
const reviewed = reviewLine(data);
---

<PageLayout title={data.title} description={data.description} noindex={data.draft}>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href={routes.tips}>Health Tips</a> <span aria-hidden="true">›</span> <span aria-current="page">{data.title}</span>
  </nav>
  {data.draft && <p class="draft-banner">Draft - awaiting review by {site.doctor.name}. Not published on the live site.</p>}
  <article class="tip">
    {data.cover && <PostCover cover={data.cover} alt={data.coverAlt} sizes="(max-width: 960px) calc(100vw - 4rem), 896px" priority class="tip-cover" />}
    <h1>{data.title}</h1>
    <div class="tip-body"><Content /></div>
  </article>

  {related.length > 0 && (
    <section class="related" aria-labelledby="related-title">
      <h2 id="related-title">Related conditions</h2>
      <ul>{related.map((c) => <li><a href={conditionHref(c.id)}>{c.data.title}</a></li>)}</ul>
    </section>
  )}

  <section class="tip-contact" aria-label="Contact the centre">
    <p>Worried about a symptom? Call {site.doctor.shortName}’s centre.</p>
    <ContactActions showBook />
  </section>

  <p class="review-note">
    {reviewed ?? `Written for ${site.name}; awaiting the doctor's review.`} · General information, not a substitute for a consultation.
  </p>
</PageLayout>

<style>
  .breadcrumb {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .breadcrumb a {
    color: var(--color-primary-ink);
    font-weight: 600;
  }

  .tip :global(.tip-cover) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
    margin-bottom: 2em;
  }

  .tip-body :global(h2) {
    font-size: 1.5rem;
    margin: 2rem 0 0.75rem;
  }

  .tip-body :global(ul),
  .tip-body :global(ol) {
    list-style: revert;
    margin: 0 0 1em 1.25em;
  }

  .tip-body :global(li) {
    font-size: 1.05em;
    line-height: 1.7;
    margin-bottom: 0.35em;
  }

  .tip-body :global(a) {
    color: var(--color-primary-ink);
    text-decoration: underline;
  }

  .related {
    margin-top: 2.5rem;
  }

  .related li {
    padding: 0.4rem 0;
  }

  .related a {
    color: var(--color-primary-ink);
    font-weight: 600;
    text-decoration: underline;
  }

  .tip-contact {
    margin-top: 2.5rem;
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    background: var(--color-primary-light);
  }

  .tip-contact p {
    font-weight: 600;
  }
</style>
