---
import PageLayout from '../../layouts/PageLayout.astro';
import { servicesPatientCare as page } from '../../data/services-patient-care';
---

<PageLayout title="Care">
  <h1>{page.title}</h1>
  <p>{page.intro}</p>
  <h2>{page.commitmentsHeading}</h2>
  <ul>
    {page.commitments.map((item) => (
      <li><strong>{item.title}</strong> {item.text}</li>
    ))}
  </ul>
</PageLayout>
