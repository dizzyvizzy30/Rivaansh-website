---
// Treatments hub. Anchors: #ear #nose #throat #head-neck #children #tests #urgent #procedures (redirect targets).
import PageLayout from '../../layouts/PageLayout.astro';
import ConditionGroups from '../../components/treatments/ConditionGroups.astro';
import ContactActions from '../../components/ui/ContactActions.astro';
import PhotoSlot from '../../components/media/PhotoSlot.astro';
import InfoNeeded from '../../components/ui/InfoNeeded.astro';
import { treatmentsPage as page, procedures, urgentProblems } from '../../data/treatments';
import { procedureGuides } from '../../data/care';
import { conditionHref, routes } from '../../config/navigation';
import { getConditions, showDrafts } from '../../data/collections';

const published = new Set((await getConditions()).map((c) => c.id));
const visibleGuides = new Set(procedureGuides.filter((g) => showDrafts || !g.draft).map((g) => g.id));
const showTests = page.testsAtClinic || showDrafts;
---

<PageLayout title="Treatments" description="Ear, nose, throat, thyroid, head & neck and children’s ENT conditions treated at Rivaansh ENT, Gota, Ahmedabad.">
  <h1>{page.title}</h1>
  <p>{page.intro}</p>
  <p class="not-listed">{page.notListed}</p>

  <nav class="jump" aria-label="Jump to">
    <a href="#ear">Ear</a><a href="#nose">Nose</a><a href="#throat">Throat</a><a href="#head-neck">Head &amp; neck</a><a href="#children">Children</a>{showTests && <a href="#tests">Tests</a>}<a href="#urgent">Urgent</a><a href="#procedures">Procedures</a>
  </nav>

  <ConditionGroups variant="list" />

  {showTests && (
    <section class="tests" id="tests" aria-labelledby="tests-title">
      <h2 id="tests-title">{page.testsHeading}</h2>
      {page.testsAtClinic ? (
        <ul class="tests-list">
          {page.testsAtClinic.map((test) => (
            <li>
              {test.slot && <PhotoSlot id={test.slot} sizes="160px" />}
              <span>{test.name}</span>
            </li>
          ))}
        </ul>
      ) : (
        <>
          <InfoNeeded what="tests done at the clinic (nasal endoscopy? hearing test?)" folder="03-conditions-review" />
          <ul class="tests-list">
            <li><PhotoSlot id="endoscope-unit" sizes="160px" /></li>
            <li><PhotoSlot id="hearing-test-room" sizes="160px" /></li>
          </ul>
        </>
      )}
    </section>
  )}

  <section class="urgent" id="urgent" aria-labelledby="urgent-title">
    <h2 id="urgent-title">{urgentProblems.title}</h2>
    <ul>{urgentProblems.items.map((item) => <li>{item}</li>)}</ul>
    <p>{urgentProblems.advice}</p>
    <ContactActions />
  </section>

  <section class="procedures" id="procedures" aria-labelledby="procedures-title">
    <h2 id="procedures-title">Procedures</h2>
    <p>Operations are only advised after an examination, when they are likely to help more than medicines.</p>
    <ul>
      {procedures.map((p) => (
        <li>
          {p.slug && published.has(p.slug) ? <a href={`${conditionHref(p.slug)}#${p.anchor}`}>{p.name}</a> : <span>{p.name}</span>}
          {p.careId && visibleGuides.has(p.careId) && <a class="care-link" href={`${routes.care}#${p.careId}`}>Before &amp; after</a>}
        </li>
      ))}
    </ul>
  </section>
</PageLayout>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 2rem;
  }

  .jump a {
    padding: 0.4rem 0.9rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-primary-ink);
  }

  .jump a:hover {
    background: var(--color-primary-light);
  }

  .not-listed {
    font-weight: 600;
  }

  .tests {
    margin-top: 3rem;
  }

  .tests h2 {
    margin-bottom: 0.75rem;
  }

  .tests-list {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.75rem;
  }

  .tests-list li {
    width: 220px;
    display: grid;
    gap: 0.5rem;
    font-weight: 600;
  }

  .urgent {
    margin: 3rem 0;
    padding: 1.75rem;
    border-radius: var(--radius-lg);
    background: #fff5f5;
    border: 1px solid #f3c5c5;
  }

  .urgent h2 {
    color: #9b1c1c;
    margin-bottom: 1rem;
  }

  .urgent li {
    padding: 0.35rem 0 0.35rem 1.5rem;
    position: relative;
  }

  .urgent li::before {
    content: '!';
    position: absolute;
    left: 0;
    font-weight: 800;
    color: #9b1c1c;
  }

  .urgent p {
    margin: 1rem 0;
    font-weight: 600;
  }

  .procedures h2 {
    margin-bottom: 0.75rem;
  }

  .procedures li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .procedures li a {
    color: var(--color-primary-ink);
    font-weight: 600;
  }

  .care-link {
    font-size: 0.9375rem;
  }
</style>
