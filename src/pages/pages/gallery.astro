---
// Editorial, full-bleed gallery with lightbox. Deep link to a photo: /pages/gallery.html#gallery-<n>
import BaseLayout from '../../layouts/BaseLayout.astro';
import MediaGallery from '../../components/media/MediaGallery.astro';
import { galleryPage as page } from '../../data/gallery';
---

<BaseLayout title="Gallery">
  <section class="gallery-page" aria-labelledby="gallery-title">
    <div class="gallery-inner">
      <header class="gallery-intro">
        <h1 id="gallery-title">{page.title}</h1>
        <p class="gallery-hint">Select a photo to view it full screen.</p>
      </header>
      <MediaGallery items={page.items} id="gallery" label="Clinic photos" priorityFirst />
    </div>
  </section>
</BaseLayout>

<style>
  .gallery-page {
    background: linear-gradient(180deg, var(--color-bg-alt) 0%, var(--color-bg) 60%);
  }

  .gallery-inner {
    max-width: var(--width-bleed);
    margin: 0 auto;
    padding: 2rem var(--gutter) 4rem;
  }

  .gallery-intro {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-bottom: 2rem;
  }

  .gallery-intro h1 {
    font-size: 2.5rem;
    color: var(--color-primary-dark);
    letter-spacing: -0.02em;
  }

  .gallery-hint {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
  }

  @media (max-width: 768px) {
    .gallery-inner {
      padding: 1.5rem var(--gutter-mobile) 3rem;
    }

    .gallery-intro h1 {
      font-size: 2rem;
    }
  }
</style>
