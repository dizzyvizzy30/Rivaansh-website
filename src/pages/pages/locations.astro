---
import PageLayout from '../../layouts/PageLayout.astro';
import MediaImage from '../../components/media/MediaImage.astro';
import { locationsPage as page } from '../../data/locations';
---

<PageLayout title="Locations">
  <h1>{page.title}</h1>
  <ul class="locations">
    {page.locations.map((location) => (
      <li class="location">
        <MediaImage image={location.image} sizes="(max-width: 767px) calc(100vw - 4rem), 448px" />
        <h2>{location.name}</h2>
        <p>
          {location.addressLines.map((line, i) => (
            <>
              {i > 0 && <br />}
              {line}
            </>
          ))}
        </p>
      </li>
    ))}
  </ul>
</PageLayout>

<style>
  .locations {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 2em;
    margin-top: 2em;
  }

  .location {
    background: var(--color-bg);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    overflow: hidden;
    text-align: center;
    padding-bottom: 1em;
  }

  .location :global(img) {
    width: 100%;
    height: 200px;
    object-fit: cover;
  }

  .location h2 {
    font-size: 1.5em;
    color: var(--color-primary-dark);
    margin: 1em;
  }

  .location p {
    font-size: 1em;
    line-height: 1.6;
    color: var(--color-text);
    margin: 0 1em 1em;
  }
</style>
