---
import PageLayout from '../../layouts/PageLayout.astro';
import StepList from '../../components/ui/StepList.astro';
import AppointmentForm from '../../components/forms/AppointmentForm.astro';
import { appointmentOnlineConsultation as page } from '../../data/appointment-online-consultation';
---

<PageLayout title="Online Consultation">
  <section class="hero-small">
    <h1>{page.title}</h1>
    <p class="subtitle">{page.subtitle}</p>
  </section>

  <section class="how-it-works" aria-labelledby="how-it-works">
    <h2 id="how-it-works">{page.stepsHeading}</h2>
    <StepList steps={page.steps} />
  </section>

  <section class="appointment-form-section" aria-labelledby="consultation-form">
    <h2 id="consultation-form">{page.formHeading}</h2>
    <AppointmentForm messageLabel={page.messageLabel} submitLabel={page.submitLabel} />
  </section>
</PageLayout>

<style>
  .hero-small {
    padding: 4em 2em;
    text-align: center;
    background-color: var(--color-bg-alt);
    border-radius: var(--radius-lg);
    margin-bottom: 3em;
  }

  .hero-small h1 {
    font-size: 2.5em;
    color: var(--color-primary-dark);
    margin-bottom: 0.5em;
  }

  .hero-small .subtitle {
    font-size: 1.2em;
    color: var(--color-text-muted);
    max-width: 600px;
    margin: 0 auto;
  }

  .how-it-works {
    text-align: center;
    margin-bottom: 3em;
  }

  .how-it-works h2 {
    font-size: 2em;
    color: var(--color-text);
    margin-bottom: 1.5em;
  }

  .appointment-form-section {
    background-color: var(--color-bg-alt);
    padding: 3em 2em;
    border-radius: var(--radius-lg);
  }

  .appointment-form-section h2 {
    text-align: center;
    font-size: 2em;
    color: var(--color-text);
    margin-bottom: 1.5em;
  }
</style>
